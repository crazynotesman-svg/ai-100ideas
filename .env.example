# --- DeepSeek (LLM enrichment) ---------------------------------------------
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub (optional, raises Search API rate limits) ----------------------
# A fine-grained or classic PAT with public-repo read is enough.
GITHUB_TOKEN=

# --- Cloudflare D1 (REST sync method — default) ----------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# --- Optional overrides -----------------------------------------------------
# Sync transport: "rest" (default) | "wrangler"
# SYNC_METHOD=rest
# Wrangler D1 binding name (used by the wrangler method)
# WRANGLER_DB_NAME=ai-100ideas-db
# Run fully offline against a fixture instead of the GitHub API:
# GITHUB_FIXTURE=scripts/fixtures/sample-repos.json
