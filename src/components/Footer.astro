---
/**
 * Site footer — copyright, tagline and legal / external links.
 */
import { GITHUB_URL, SITE_NAME } from '../consts';
import { getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro);
const t = useTranslations(lang);

const year = new Date().getFullYear();

const links = [
  { href: '/tags', label: t('footer.tags') },
  { href: '/privacy', label: t('footer.privacy') },
  { href: '/terms', label: t('footer.terms') },
  { href: '/sitemap.xml', label: t('footer.sitemap') },
  { href: GITHUB_URL, label: t('footer.github'), external: true },
];
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex items-center gap-2 font-semibold text-slate-900">
          <span class="grid h-7 w-7 place-items-center rounded-md bg-indigo-600 text-xs font-bold text-white">100</span>
          <span>{t('header.brand')}</span>
        </div>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-500">{t('footer.tagline')}</p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {links.map((l) =>
          l.external ? (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-600 transition hover:text-slate-900">{l.label}</a>
          ) : (
            <a href={l.href} class="text-sm text-slate-600 transition hover:text-slate-900">{l.label}</a>
          )
        )}
      </nav>
    </div>

    <p class="mt-8 text-xs text-slate-400">© {year} {SITE_NAME}. {t('footer.rights')}</p>
  </div>
</footer>
