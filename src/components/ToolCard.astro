---
/**
 * ToolCard — compact directory card for a single tool.
 * Renders name, stars, license / MCP badges, one-liner, tech-stack tags and
 * "alternative to" links. Carries data-* attributes for client-side filtering.
 */
import type { Tool } from '../db/schema';
import { categoryLabel, formatStars, slugify } from '../lib/format';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const tags = tool.techStack ?? [];
const alts = tool.alternativeTo ?? [];
const cat = categoryLabel(tool.categoryId);
const searchBlob = [
  tool.name,
  tool.oneLiner ?? '',
  tags.join(' '),
  alts.join(' '),
  cat,
]
  .join(' ')
  .toLowerCase();
---

<article
  class="tool-card group flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm"
  data-name={tool.name.toLowerCase()}
  data-category={tool.categoryId ?? ''}
  data-tags={searchBlob}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-slate-900">
      <a href={`/tool/${tool.slug}`} class="transition hover:text-indigo-600">{tool.name}</a>
    </h3>
    <div class="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
      {tool.isMcp && (
        <span class="rounded-full bg-purple-100 px-2 py-0.5 text-[11px] font-semibold text-purple-700">MCP</span>
      )}
      {tool.license && (
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">{tool.license}</span>
      )}
    </div>
  </div>

  {tool.oneLiner && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{tool.oneLiner}</p>}

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
    <span class="inline-flex items-center gap-1 font-medium">
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
        <path d="m12 2 2.95 6.06 6.55.95-4.75 4.63 1.12 6.54L12 17.9l-5.87 3.28 1.12-6.54L2.5 9.01l6.55-.95L12 2Z"></path>
      </svg>
      {formatStars(tool.stars)}
    </span>
    <span class="text-slate-300">·</span>
    <span>{cat}</span>
    {tool.isOpenSource && (
      <>
        <span class="text-slate-300">·</span>
        <span class="text-emerald-600">Open source</span>
      </>
    )}
  </div>

  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 5).map((t) => (
        <span class="rounded-md bg-slate-50 px-2 py-0.5 text-[11px] text-slate-500 ring-1 ring-slate-100">{t}</span>
      ))}
    </div>
  )}

  {alts.length > 0 && (
    <div class="mt-3 border-t border-slate-100 pt-3">
      <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">Alternative to</p>
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        {alts.slice(0, 4).map((a) => (
          <a
            href={`/alternative-to/${slugify(a)}`}
            class="rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700 transition hover:bg-emerald-100"
          >
            {a}
          </a>
        ))}
      </div>
    </div>
  )}
</article>
