---
/**
 * BaseLayout — the SEO foundation for every page on ai.100ideas.net.
 *
 * Handles: title/description/keywords, canonical URL, robots directives,
 * OpenGraph, Twitter Cards and Schema.org JSON-LD injection.
 *
 * Usage:
 *   <BaseLayout
 *     title="Open source alternatives to Notion"
 *     description="..."
 *     keywords={['notion alternative', 'open source']}
 *     jsonLd={{ '@context': 'https://schema.org', '@type': 'ItemList', ... }}
 *   >
 *     <h1>...</h1>
 *   </BaseLayout>
 */
import '../styles/global.css';

import {
  DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_LOCALE,
  SITE_NAME,
  SITE_TITLE,
  TWITTER_HANDLE,
} from '../consts';
import { getLang, type Lang } from '../i18n/ui';
import { buildOgUrl } from '../lib/og';

export interface Props {
  /** Page title. Rendered as `{title} | {SITE_NAME}` unless `titleTemplate` is false. */
  title?: string;
  /** Set false to use `title` verbatim (for the home page / brand pages). */
  titleTemplate?: boolean;
  description?: string;
  keywords?: string[] | string;
  /** Social share image — root-relative path or absolute URL. */
  image?: string;
  imageAlt?: string;
  /** OpenGraph object type. */
  ogType?: 'website' | 'article' | 'profile';
  /** Override the canonical URL (defaults to the current path on `site`). */
  canonical?: string | URL;
  /** Emit `noindex, nofollow` — use for search results, admin, thin pages. */
  noindex?: boolean;
  /** Schema.org structured data. Accepts one object or an array of objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** ISO date strings for article-type pages. */
  publishedTime?: string;
  modifiedTime?: string;

  /**
   * Dynamic OpenGraph enrichment. When provided, the rendered `og:image` /
   * `twitter:image` point at the edge SVG generator (/api/og) instead of the
   * static fallback. Leave `image` at its default to opt in automatically.
   */
  ogStars?: number;
  ogLicense?: string | null;
  ogTags?: string[] | null;
  /** Page kind passed to the dynamic OG endpoint (tool/tag/mcp/...). */
  ogKind?: string;
  /** Override the OG card title (defaults to the page title). */
  ogTitle?: string;
}

const {
  title,
  titleTemplate = true,
  description = SITE_DESCRIPTION,
  keywords = SITE_KEYWORDS,
  image = DEFAULT_OG_IMAGE,
  imageAlt,
  ogType = 'website',
  canonical,
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  ogStars,
  ogLicense,
  ogTags,
  ogKind,
  ogTitle,
} = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs — required for absolute URLs.
const siteOrigin = Astro.site ?? new URL('https://ai.100ideas.net');

/**
 * `build.format: 'file'` renders the home page at `/index.html`, so the raw
 * pathname would leak `.html` into canonical/og:url. Normalise to the extensionless,
 * no-trailing-slash shape that @astrojs/sitemap emits, so both agree exactly.
 */
const normalizePath = (pathname: string): string => {
  const withoutIndex = pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
  const trimmed = withoutIndex.length > 1 ? withoutIndex.replace(/\/+$/, '') : withoutIndex;
  return trimmed === '' ? '/' : trimmed;
};

const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteOrigin);
canonicalURL.pathname = normalizePath(canonicalURL.pathname);
const canonicalHref = canonicalURL.pathname === '/' ? canonicalURL.origin : canonicalURL.href;

// Resolve the active UI language so <html lang>, og:locale and the dynamic
// OG card all stay in sync with the visitor's preference.
const lang: Lang = getLang(Astro);
const ogLocale = lang === 'zh' ? 'zh_CN' : SITE_LOCALE;

/**
 * Social share image. A page opts into the dynamic edge generator by leaving
 * `image` at its default; if an explicit custom image is supplied we honour it
 * instead. The dynamic card is built from the page title/description plus any
 * optional stats (stars / license / tags).
 */
const socialImageURL = image && image !== DEFAULT_OG_IMAGE
  ? new URL(image, siteOrigin)
  : buildOgUrl({
      title: ogTitle ?? title ?? SITE_TITLE,
      description,
      stars: ogStars,
      license: ogLicense,
      tags: ogTags,
      type: ogKind,
      lang,
    });

const pageTitle = title ? (titleTemplate ? `${title} | ${SITE_NAME}` : title) : `${SITE_NAME} — ${SITE_TITLE}`;

const keywordsContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;

const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

/**
 * Escape `<` so a payload can never terminate the surrounding <script> tag.
 * JSON-LD must be injected raw, so this is the guard that keeps it safe.
 */
const structuredData = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? pageTitle} />
    <meta property="og:locale" content={ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt ?? pageTitle} />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />

    <!-- Icons & feeds -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Schema.org structured data -->
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}

    <!-- Per-page head extras (extra preloads, alternate links, ...) -->
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
