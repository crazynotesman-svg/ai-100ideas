---
/**
 * /tags — index of every tag. Aids crawl discovery and the internal link web:
 * every tool card links its tech stack to /tag/[slug], so this page is the
 * hub that Google (and visitors) can reach all aggregation pages from.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllTags } from '../../db/queries';
import { tagLabel } from '../../lib/tags';
import { getLang, useTranslations } from '../../i18n/ui';
import { SITE_URL } from '../../consts';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const tags = await getAllTags();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: tr('tags.title'),
  description: lang === 'zh'
    ? '按技术栈、协议与使用场景浏览开源 AI 工具。'
    : 'Explore open-source AI tools grouped by tech stack, protocol and use case.',
  url: `${SITE_URL}/tags`,
};
---

<BaseLayout
  title={tr('tags.title')}
  description={lang === 'zh'
    ? '按技术栈、协议与使用场景浏览开源 AI 工具——Rust、Python、MCP、本地大模型等。'
    : 'Explore open-source AI tools grouped by tech stack, protocol and use case — Rust, Python, MCP, local-LLM and more.'}
  keywords={['AI tags', 'open source AI tools', 'tech stack']}
  ogTitle={tr('tags.title')}
  ogKind="tags"
  jsonLd={jsonLd}
>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900">{tr('nav.home')}</a>
      </nav>
      <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        {tr('tags.title')}
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">{tr('tags.subtitle', { n: tags.length })}</p>
    </header>

    <section class="mt-8 flex flex-wrap gap-2">
      {
        tags.map((t) => (
          <a
            href={`/tag/${t.slug}`}
            class="group flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 transition hover:border-indigo-400 hover:text-indigo-600"
          >
            <span class="font-medium">{tagLabel(t.slug)}</span>
            <span class="rounded-full bg-slate-100 px-1.5 text-xs text-slate-500 transition group-hover:bg-indigo-50 group-hover:text-indigo-600">{t.count}</span>
          </a>
        ))
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
