---
/**
 * /alternative-to/[software] — "Best open source alternatives to X" landing page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getAlternativeGroups, getToolsByAlternativeTo } from '../../db/queries';
import { SITE_URL } from '../../consts';

export const prerender = false;

const { software } = Astro.params;
const groups = await getAlternativeGroups();
const match = software ? groups.find((g) => g.slug === software) : undefined;
const tools = software ? await getToolsByAlternativeTo(software) : [];

// Resolve a display name from the slug; fall back to a de-slugified guess.
const name = match?.name ?? (software ? software.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : '');

if (!match && tools.length === 0) {
  Astro.response.status = 404;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Best Open Source Alternatives to ${name}`,
  description: `A curated list of open-source alternatives to ${name}. Compare self-hostable tools that replace ${name}.`,
  url: `${SITE_URL}/alternative-to/${software}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tools.slice(0, 20).map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/tool/${t.slug}`,
      name: t.name,
    })),
  },
};
---

<BaseLayout
  title={`Best Open Source Alternatives to ${name}`}
  description={`Find the best open-source alternatives to ${name}. Compare self-hostable, license-friendly tools that replace ${name}.`}
  keywords={[`${name} alternative`, 'open source alternative', 'self-hosted', name]}
  jsonLd={jsonLd}
  noindex={!match && tools.length === 0}
>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <h1 class="text-balance text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        Best Open Source Alternatives to {name}
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {tools.length} open-source tool{tools.length === 1 ? '' : 's'} that can replace {name}. {tools.length > 0 && 'Compare tech stacks, licenses and stars below.'}
      </p>
    </header>

    <section class="mt-8">
      {
        tools.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm text-slate-500">
            No open-source alternatives to {name} indexed yet.
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
