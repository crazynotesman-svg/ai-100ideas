---
/**
 * /category/[slug] — tools within a single category.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getCategoryBySlug, getToolsByCategory } from '../../db/queries';
import { categoryLabel } from '../../lib/format';
import { getLang, useTranslations } from '../../i18n/ui';
import { SITE_URL } from '../../consts';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : undefined;
const tools = slug ? await getToolsByCategory(slug) : [];

if (!category) {
  Astro.response.status = 404;
}

const label = category?.name ?? (slug ? categoryLabel(slug, lang) : '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${label} — open-source AI tools`,
  description: category?.description || `Browse open-source ${label.toLowerCase()} in the 100 Ideas AI directory.`,
  url: `${SITE_URL}/category/${slug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tools.slice(0, 20).map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/tool/${t.slug}`,
      name: t.name,
    })),
  },
};
---

<BaseLayout
  title={`${label} — Open Source AI Tools`}
  description={category?.description || `Browse open-source ${label.toLowerCase()} in the 100 Ideas AI directory.`}
  keywords={[label, 'open source AI tools', 'AI directory']}
  ogTitle={label}
  ogKind="category"
  jsonLd={jsonLd}
  noindex={!category}
>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900">{tr('nav.home')}</a>
        <span class="px-2 text-slate-300">/</span>
        <a href="/categories" class="hover:text-slate-900">{tr('nav.categories')}</a>
      </nav>
      <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{label}</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {tools.length} {lang === 'zh' ? `个该分类下的开源工具。` : `open-source tool${tools.length === 1 ? '' : 's'} in this category.`}
      </p>
    </header>

    <section class="mt-8">
      {
        tools.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm text-slate-500">
            {tr('catpage.empty')}
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
