---
/**
 * /tag/[tag] — programmatic SEO aggregation page.
 * Lists every tool carrying the tag (tech stack / mcp / local-llm / ...).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getTagBySlug, getToolsByTag } from '../../db/queries';
import { tagLabel } from '../../lib/tags';
import { getLang, useTranslations } from '../../i18n/ui';
import { SITE_URL } from '../../consts';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const { tag } = Astro.params;
const tagInfo = tag ? await getTagBySlug(tag) : undefined;
const tools = tag ? await getToolsByTag(tag) : [];

if (!tagInfo) {
  Astro.response.status = 404;
}

const label = tag ? tagLabel(tag) : '';
const year = new Date().getFullYear();
const titleLabel = lang === 'zh' ? `最佳 ${label} 工具与框架` : `Best ${label} Tools & Frameworks`;
const description = lang === 'zh'
  ? `发现 ${tools.length}+ 个面向开发者的开源 ${label} 工具（${year}）。对比技术栈、许可证与 GitHub 星标——由 100 Ideas AI 精心整理。`
  : `Discover ${tools.length}+ open-source ${label} tools for developers in ${year}. Compare tech stacks, licenses and GitHub stars — curated by 100 Ideas AI.`;

const jsonLd = tagInfo
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: titleLabel,
      description,
      url: `${SITE_URL}/tag/${tag}`,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: tools.slice(0, 20).map((t, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${SITE_URL}/tool/${t.slug}`,
          name: t.name,
        })),
      },
    }
  : undefined;
---

<BaseLayout
  title={titleLabel}
  description={description}
  keywords={[label, 'open source AI tools', 'AI directory', `${label} tools`]}
  ogTitle={titleLabel}
  ogKind="tag"
  ogStars={tools.length}
  jsonLd={jsonLd}
  noindex={!tagInfo}
>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900">{tr('nav.home')}</a>
        <span class="px-2 text-slate-300">/</span>
        <a href="/tags" class="hover:text-slate-900">{tr('nav.tags')}</a>
      </nav>
      <h1 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
        {titleLabel}
      </h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        {tools.length} {lang === 'zh' ? `个开源 ${label} 工具` : `open-source ${label} tool${tools.length === 1 ? '' : 's'}`} {lang === 'zh' ? '面向开发者。' : ' for developers.'}
        {lang === 'zh' ? '在一个页面内对比技术栈、许可证与 GitHub 星标。' : 'Compare tech stacks, licenses and GitHub stars — all in one place.'}
      </p>
    </header>

    <section class="mt-8">
      {
        tools.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm text-slate-500">
            {tr('tag.empty', { label })}
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
