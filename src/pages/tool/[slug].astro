---
/**
 * /tool/[slug] — individual tool detail page.
 * Renders Markdown description, a dedicated Pros/Cons box (parsed out of
 * description_md), links and SoftwareApplication + BreadcrumbList JSON-LD.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getToolBySlug, getRelatedTools } from '../../db/queries';
import { categoryLabel, formatStars, slugify } from '../../lib/format';
import { getLang, useTranslations } from '../../i18n/ui';
import { parseDescription, renderMarkdown } from '../../lib/markdown';
import { SITE_URL } from '../../consts';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const { slug } = Astro.params;
const tool = slug ? await getToolBySlug(slug) : undefined;

if (!tool) {
  Astro.response.status = 404;
}

const parsed = parseDescription(tool?.descriptionMd);
const bodyHtml = renderMarkdown(parsed.lead);
const cat = tool?.categoryId ? categoryLabel(tool.categoryId, lang) : '';
const alts = tool?.alternativeTo ?? [];
const related = tool ? await getRelatedTools(tool) : [];

const jsonLd = tool
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: tool.name,
        description: tool.oneLiner ?? `${tool.name} — open-source AI tool.`,
        applicationCategory: cat || 'DeveloperApplication',
        operatingSystem: 'Web',
        url: tool.websiteUrl || tool.githubUrl || `${SITE_URL}/tool/${tool.slug}`,
        sameAs: [tool.githubUrl].filter(Boolean) as string[],
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: tr('nav.home'), item: `${SITE_URL}/` },
          ...(tool.categoryId
            ? [{ '@type': 'ListItem' as const, position: 2, name: cat, item: `${SITE_URL}/category/${tool.categoryId}` }]
            : []),
          { '@type': 'ListItem', position: tool.categoryId ? 3 : 2, name: tool.name, item: `${SITE_URL}/tool/${tool.slug}` },
        ],
      },
    ]
  : null;
---

<BaseLayout
  title={tool ? tool.name : tr('tool.notFound')}
  description={tool?.oneLiner ?? tr('tool.notFoundDesc', { slug: slug ?? '' })}
  keywords={tool ? [tool.name, cat, ...(tool.techStack ?? [])] : undefined}
  ogTitle={tool?.name}
  ogKind="tool"
  ogStars={tool?.stars}
  ogLicense={tool?.license}
  ogTags={tool?.techStack}
  jsonLd={jsonLd ?? undefined}
  noindex={!tool}
>
  <Header />

  {
    !tool ? (
      <main class="mx-auto max-w-3xl px-4 py-24 text-center">
        <h1 class="text-3xl font-semibold text-slate-900">{tr('tool.notFound')}</h1>
        <p class="mt-3 text-slate-600">{tr('tool.notFoundDesc', { slug: slug ?? '' })}</p>
        <a href="/" class="mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
          {tr('tool.browseAll')}
        </a>
      </main>
    ) : (
      <main class="mx-auto max-w-5xl px-4 py-10">
        <!-- Breadcrumb -->
        <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-900">{tr('nav.home')}</a>
          {tool.categoryId && (
            <>
              <span class="px-2 text-slate-300">/</span>
              <a href={`/category/${tool.categoryId}`} class="hover:text-slate-900">{cat}</a>
            </>
          )}
          <span class="px-2 text-slate-300">/</span>
          <span class="text-slate-700">{tool.name}</span>
        </nav>

        <!-- Header -->
        <header class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-3xl font-semibold tracking-tight text-slate-900">{tool.name}</h1>
              {tool.isMcp && (
                <span class="rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-semibold text-purple-700">MCP</span>
              )}
              {tool.isOpenSource && (
                <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">{tr('card.openSource')}</span>
              )}
            </div>
            {tool.oneLiner && <p class="mt-2 max-w-2xl text-lg text-slate-600">{tool.oneLiner}</p>}
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700">
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-amber-500" fill="currentColor" aria-hidden="true">
                <path d="m12 2 2.95 6.06 6.55.95-4.75 4.63 1.12 6.54L12 17.9l-5.87 3.28 1.12-6.54L2.5 9.01l6.55-.95L12 2Z"></path>
              </svg>
              {formatStars(tool.stars)}
            </span>
            {tool.license && (
              <span class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm text-slate-600">{tool.license}</span>
            )}
          </div>
        </header>

        <!-- Body + sidebar -->
        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="lg:col-span-2">
            {bodyHtml && <div class="md-body" set:html={bodyHtml} />}

            {
              parsed.pros.length > 0 && (
                <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50/60 p-5">
                  <h2 class="text-sm font-semibold uppercase tracking-wide text-emerald-700">{tr('tool.pros')}</h2>
                  <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
                    {parsed.pros.map((p) => (
                      <li class="flex gap-2">
                        <span class="text-emerald-600">+</span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              parsed.cons.length > 0 && (
                <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50/60 p-5">
                  <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-700">{tr('tool.cons')}</h2>
                  <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
                    {parsed.cons.map((c) => (
                      <li class="flex gap-2">
                        <span class="text-amber-600">−</span>
                        <span>{c}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              parsed.audience && (
                <p class="mt-4 text-sm text-slate-500">
                  <span class="font-medium text-slate-700">{tr('tool.audience')}</span> {parsed.audience}
                </p>
              )
            }
          </div>

          <!-- Sidebar -->
          <aside class="space-y-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h2 class="text-sm font-semibold text-slate-900">{tr('tool.links')}</h2>
              <div class="mt-3 space-y-2">
                {tool.githubUrl && (
                  <a href={tool.githubUrl} target="_blank" rel="noopener noreferrer" class="block rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300">
                    {tr('tool.viewGithub')}
                  </a>
                )}
                {tool.websiteUrl && (
                  <a href={tool.websiteUrl} target="_blank" rel="noopener noreferrer" class="block rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300">
                    {tr('tool.website')}
                  </a>
                )}
                {tool.categoryId && (
                  <a href={`/category/${tool.categoryId}`} class="block rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300">
                    {tr('tool.category')} {cat} →
                  </a>
                )}
              </div>
            </div>

            {
              alts.length > 0 && (
                <div class="rounded-xl border border-slate-200 bg-white p-5">
                  <h2 class="text-sm font-semibold text-slate-900">{tr('tool.altTo')}</h2>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {alts.map((a) => (
                      <a
                        href={`/alternative-to/${slugify(a)}`}
                        class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 transition hover:bg-emerald-100"
                      >
                        {a}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }

            {
              (tool.techStack ?? []).length > 0 && (
                <div class="rounded-xl border border-slate-200 bg-white p-5">
                  <h2 class="text-sm font-semibold text-slate-900">{tr('tool.techStack')}</h2>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {(tool.techStack ?? []).map((t) => (
                      <a
                        href={`/tag/${slugify(t)}`}
                        class="rounded-md bg-slate-50 px-2 py-1 text-xs text-slate-600 ring-1 ring-slate-100 transition hover:bg-indigo-50 hover:text-indigo-600"
                      >
                        {t}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </aside>
        </div>

        {
          related.length > 0 && (
            <section class="mt-12 border-t border-slate-200 pt-8">
              <h2 class="text-xl font-semibold text-slate-900">{tr('tool.related')}</h2>
              <p class="mt-1 text-sm text-slate-500">{tr('tool.relatedDesc', { name: tool.name })}</p>
              <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {related.map((t) => (
                  <ToolCard tool={t} />
                ))}
              </div>
            </section>
          )
        }
      </main>
    )
  }

  <Footer />
</BaseLayout>

<style>
  .md-body {
    color: #334155;
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .md-body :global(p) {
    margin: 0.75rem 0;
  }
  .md-body :global(h2) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: #0f172a;
  }
  .md-body :global(h3) {
    margin: 1.25rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #0f172a;
  }
  .md-body :global(ul) {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .md-body :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .md-body :global(li) {
    margin: 0.25rem 0;
  }
  .md-body :global(a) {
    color: #4f46e5;
    text-decoration: underline;
  }
  .md-body :global(code) {
    background: #f1f5f9;
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
  .md-body :global(pre) {
    background: #0f172a;
    color: #f1f5f9;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .md-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .md-body :global(strong) {
    color: #0f172a;
    font-weight: 600;
  }
</style>
