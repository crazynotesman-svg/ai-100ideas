---
/**
 * /categories — index of all categories with tool counts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCategoriesWithCounts } from '../../db/queries';
import { getLang, useTranslations } from '../../i18n/ui';
import { SITE_URL } from '../../consts';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const counts = await getCategoriesWithCounts();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: tr('cat.title'),
  description: lang === 'zh'
    ? '按分类浏览开源 AI 工具——MCP 服务器、智能体、向量数据库等。'
    : 'Browse open-source AI tools by category — MCP servers, AI agents, vector databases, RAG frameworks, self-hosted AI and more.',
  url: `${SITE_URL}/categories`,
};
---

<BaseLayout
  title={tr('cat.title')}
  description={lang === 'zh'
    ? '按分类浏览开源 AI 工具——MCP 服务器、AI 智能体、向量数据库、RAG 框架、自托管 AI 等。'
    : 'Browse open-source AI tools by category — MCP servers, AI agents, vector databases, RAG frameworks, self-hosted AI and more.'}
  keywords={['AI tool categories', 'MCP servers', 'AI agents', 'vector databases']}
  ogTitle={tr('cat.title')}
  ogKind="categories"
  jsonLd={jsonLd}
>
  <Header active="categories" />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{tr('cat.title')}</h1>
      <p class="mt-3 max-w-2xl text-slate-600">{tr('cat.subtitle')}</p>
    </header>

    <section class="mt-8">
      {
        counts.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm text-slate-500">
            {tr('cat.empty')}
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {counts.map(({ category, count }) => (
              <a
                href={`/category/${category.slug}`}
                class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm"
              >
                <span class="font-medium text-slate-900 group-hover:text-indigo-600">{category.name}</span>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">{count}</span>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
