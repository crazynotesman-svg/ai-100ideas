---
/**
 * /terms — static legal page (SSR so it localizes with the language cookie).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useTranslations } from '../i18n/ui';

export const prerender = false;

const lang = getLang(Astro);
const tr = useTranslations(lang);

const updated = new Date().getFullYear();
---

<BaseLayout
  title={tr('terms.title')}
  description={lang === 'zh' ? '100 Ideas AI 的服务条款。' : 'Terms of Service for 100 Ideas AI.'}
  ogTitle={tr('terms.title')}
  ogKind="default"
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">{tr('terms.title')}</h1>
    <p class="mt-2 text-sm text-slate-500">{tr('terms.updated')} {updated}</p>

    <div class="mt-8 space-y-6 text-sm leading-relaxed text-slate-700">
      <section>
        <h2 class="text-lg font-semibold text-slate-900">{tr('terms.s1h')}</h2>
        <p class="mt-2">{tr('terms.s1b')}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">{tr('terms.s2h')}</h2>
        <p class="mt-2">{tr('terms.s2b')}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-slate-900">{tr('terms.s3h')}</h2>
        <p class="mt-2">{tr('terms.s3b')}</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
