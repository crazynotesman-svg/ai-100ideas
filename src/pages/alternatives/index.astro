---
/**
 * /alternatives — index of every "open source alternative to X" target.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAlternativeGroups } from '../../db/queries';
import { SITE_URL } from '../../consts';

export const prerender = false;

const groups = await getAlternativeGroups();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Open Source Alternatives',
  description: 'Browse open-source alternatives to popular commercial AI products.',
  url: `${SITE_URL}/alternatives`,
};
---

<BaseLayout
  title="Open Source Alternatives"
  description="Find open-source alternatives to popular commercial AI products. Browse self-hostable replacements by product."
  keywords={['open source alternatives', 'self-hosted', 'alternative to']}
  jsonLd={jsonLd}
>
  <Header active="alternatives" />

  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Open Source Alternatives</h1>
      <p class="mt-3 max-w-2xl text-slate-600">
        Self-hostable, license-friendly tools that replace commercial AI products. {groups.length} product{groups.length === 1 ? '' : 's'} covered.
      </p>
    </header>

    <section class="mt-8">
      {
        groups.length === 0 ? (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center text-sm text-slate-500">
            No alternatives indexed yet.
          </p>
        ) : (
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {groups.map((g) => (
              <a
                href={`/alternative-to/${g.slug}`}
                class="group flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm"
              >
                <span class="font-medium text-slate-900 group-hover:text-indigo-600">{g.name}</span>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">{g.count}</span>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
